{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/guido/.claude/hooks/session-start-arisrv.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/guido/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "skillOverrides": {
    "pptx": "off",
    "xlsx": "off",
    "docs": "off",
    "skill-creator": "off",
    "morning": "off",
    "import-memory": "off"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CLAUDE_API_SKILL": "1",
    "CAVECREW_REVIEWER_MODEL": "opus"
  },
  "outputStyle": "Concise"
}
